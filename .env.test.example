# Settings for the Linux test stack only. Copy this file to .env.test on the server.
# Do not use these values for a public production deployment.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=gadget_test
POSTGRES_USER=gadget_test
POSTGRES_PASSWORD=replace-with-a-strong-test-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# MQTT is available only inside Docker during this test.
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=0
MQTT_TOPIC_ROOT=gadget/v1

HEALTH_CHECK_STALE_AFTER_SECONDS=180
DEVICE_HEARTBEAT_STALE_AFTER_SECONDS=300

# WordPress is intentionally disabled for this test.
WORDPRESS_WEBHOOK_SECRET=replace-with-a-random-test-secret
WORDPRESS_API_BASE_URL=
WORDPRESS_API_TOKEN=
WORDPRESS_DEVICES_ENDPOINT=/wp-json/gadget/v1/devices
WORDPRESS_DATA_SOURCES_ENDPOINT=/wp-json/gadget/v1/data-sources
WORDPRESS_SYNC_TRIGGER_TOKEN=replace-with-a-random-test-token
WORDPRESS_WEBHOOK_MAX_AGE_SECONDS=300
SYNC_NOTIFY_WEBHOOK_URL=

METRICS_TOKEN=replace-with-a-random-test-token
