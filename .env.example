DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=gadget
POSTGRES_USER=gadget
POSTGRES_PASSWORD=gadget
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=0
MQTT_TOPIC_ROOT=gadget/v1
CELERY_BROKER_URL=redis://redis:6379/0
HEALTH_CHECK_STALE_AFTER_SECONDS=180
DEVICE_HEARTBEAT_STALE_AFTER_SECONDS=300

WORDPRESS_WEBHOOK_SECRET=change-me
WORDPRESS_API_BASE_URL=https://example.com
WORDPRESS_API_TOKEN=
WORDPRESS_DEVICES_ENDPOINT=/wp-json/gadget/v1/devices
WORDPRESS_DATA_SOURCES_ENDPOINT=/wp-json/gadget/v1/data-sources
WORDPRESS_SYNC_TRIGGER_TOKEN=change-me-too
WORDPRESS_WEBHOOK_MAX_AGE_SECONDS=300
SYNC_NOTIFY_WEBHOOK_URL=
METRICS_TOKEN=change-me-for-production
